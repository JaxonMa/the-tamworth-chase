        {
          "trigger": "place",
          "text": "预测会随布局实时变化，换个位置再看看。"
        },
        {
          "trigger": "run",
          "text": "开始之后，每走一步预测都会重新计算。"
        },
        {
          "trigger": "win",
          "text": "善用预测，可以少走很多弯路。"
        }
      ],
