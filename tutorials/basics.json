{
  "title": "基础教程",
  "subtitle": "从转向、前进到出口前的拦截",
  "intro": "七节短课：绝对方向转向、前进、出口、逃跑、地形遮挡、拦截，以及撤销与预测。",
  "badge": "基础",
  "accent": "leaf",
  "lessons": [
    {
      "id": "basics_01",
      "name": "朝哪走",
      "brief": "W/A/S/D 或方向键改变绝对朝向，空格朝当前朝向走一格。",
      "goal": "用转向和前进抓住牛。",
      "practice": "先按 W/↑（当前已朝上）确认无效，再用转向和空格抓住牛。",
      "tips": [
        {
          "trigger": "start",
          "text": "W/↑ 朝上，S/↓ 朝下，A/← 朝左，D/→ 朝右，空格前进。每回合必须转向或前进。"
        },
        {
          "trigger": "invalid",
          "text": "已朝该方向。这次操作无效，回合数没有增加；也不能原地不动。"
        },
        {
          "trigger": "turn",
          "text": "转向会消耗一个回合，但不会移动。"
        },
        {
          "trigger": "forward",
          "text": "空格让农夫朝当前朝向前进一格。"
        },
        {
          "trigger": "win",
          "text": "抓住了！现在你已经会用绝对方向驾驶农夫。"
        }
      ],
      "level": {
        "id": "basics_01",
        "name": "朝哪走",
        "grid": [
          "#######",
          "#.....#",
          "#...C.#",
          "#.....#",
          "#.....#",
          "#F....#",
          "#######"
        ],
        "fj_start_direction": "north",
        "cow_facings": [
          "east"
        ],
        "exit_cells": [
          [
            1,
            1
          ]
        ],
        "max_turns": 14,
        "prediction_steps": 5,
        "exit_sight_range": 0,
        "sight_range": -1,
        "exit_tiebreak": "right",
        "flee_tiebreak": "right",
        "cows_block_sight": false,
        "cows_block_each_other": false,
        "s_threshold": 6,
        "a_threshold": 9,
        "b_threshold": 12,
        "require_invalid": true,
        "require_forward": true
      }
    },
    {
      "id": "basics_02",
      "name": "撞墙的代价",
      "brief": "撞墙前进位置不变，但会消耗回合。",
      "goal": "先撞一次墙，再抓住牛。",
      "practice": "先按空格朝北撞一次墙，再转向抓牛。",
      "tips": [
        {
          "trigger": "start",
          "text": "农夫前面就是围栏。按空格前进，看看会发生什么。"
        },
        {
          "trigger": "blocked",
          "text": "前方受阻，本回合已消耗。位置和朝向都不变。"
        },
        {
          "trigger": "step",
          "text": "先转向，再前进。农场里的每一回合都很宝贵。"
        },
        {
          "trigger": "win",
          "text": "撞墙不移动，但会浪费回合。记住这一点。"
        }
      ],
      "level": {
        "id": "basics_02",
        "name": "撞墙的代价",
        "grid": [
          "#######",
