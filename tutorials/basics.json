{
  "version": 1,
  "chapter": "basics",
  "title": "基础教程",
  "subtitle": "从认识牧场开始",
  "intro": "六节短课，从同步移动到时间闭环。每节课只讲一个新机制，随时可以跳过。",
  "badge": "基础",
  "accent": "leaf",
  "lessons": [
    {
      "id": "basics_01",
      "name": "一起出发",
      "brief": "先看看农夫和牛是怎么一起走路的。",
      "goal": "观察同步移动，让他们自然相遇。",
      "practice": "点击「开始游戏」，看两位主角一起动起来。",
      "tips": [
        {
          "trigger": "start",
          "text": "农夫和牛每回合同时移动：前方能走就前进，否则顺时针转 90°。"
        },
        {
          "trigger": "run",
          "text": "现在点「开始游戏」，看他们一起动。"
        },
        {
          "trigger": "step",
          "text": "每一回合两人同时走一步，注意看他们的朝向。"
        },
        {
          "trigger": "win",
          "text": "碰到一起就算抓住！这就是最基础的追逐。"
        }
      ],
      "level": {
