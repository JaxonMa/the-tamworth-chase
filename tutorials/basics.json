{
  "title": "基础教程",
  "subtitle": "从走一步开始，学会追逐",
  "intro": "五节短课，每节只介绍一件事。可以跳过任何一节，也可以随时重玩。",
  "badge": "基础",
  "accent": "leaf",
  "lessons": [
    {
      "id": "basics_01",
      "name": "第一步",
      "brief": "用方向键移动农夫，牛会在你之后走一步。",
      "goal": "抓住牛",
      "practice": "用方向键或 WASD 移动农夫，至少走一步。",
      "tips": [
        {
          "trigger": "start",
          "text": "用方向键或 WASD 移动农夫。你走一步，牛才会走一步。"
        },
        {
          "trigger": "move",
          "text": "注意：农夫先动，牛后动。牛撞到围栏时会顺时针转身。"
        },
        {
          "trigger": "win",
          "text": "和牛站在同一格就抓住了。基础教程开始！"
        }
      ],
      "level": {
        "id": "basics_01",
        "name": "第一步",
