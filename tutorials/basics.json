    {
      "id": "basics_02",
      "name": "第一捆干草",
      "brief": "把干草垛放在牛的正前方，逼它转弯。",
      "goal": "用一捆干草改变牛的路线。",
      "practice": "点击草地放下干草垛，然后开始游戏。",
      "tips": [
