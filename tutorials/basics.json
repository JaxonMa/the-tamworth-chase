  "lessons": [
    {
      "id": "basics_01",
      "name": "第一步",
      "brief": "前进、左转、右转；转向会消耗回合。",
      "goal": "抓住牧场上的牛。",
      "practice": "先按 A/← 和 D/→ 各转一次，再抓住牛。",
      "tips": [
        {
          "trigger": "start",
          "text": "W/↑ 前进，A/← 左转，D/→ 右转。转向不移动，但会消耗一个回合。"
        },
        {
          "trigger": "step",
          "text": "注意农夫有朝向：前进只会朝当前方向走一格。"
        },
        {
          "trigger": "win",
          "text": "抓住了！接下来学会看出口。"
        }
      ],
      "level": {
