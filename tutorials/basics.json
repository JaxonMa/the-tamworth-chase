          ]
        ],
        "max_turns": 18,
        "prediction_steps": 5,
        "exit_sight_range": 0,
        "sight_range": -1,
        "exit_tiebreak": "right",
        "flee_tiebreak": "right",
        "cows_block_sight": false,
        "cows_block_each_other": false,
        "s_threshold": 9,
        "a_threshold": 12,
        "b_threshold": 15,
        "require_block": true
      }
    },
    {
      "id": "basics_03",
      "name": "出口在哪",
      "brief": "牛看不到农夫时，会朝它看得见的出口走。",
      "goal": "观察牛的路线，在它到达出口前抓住它。",
      "practice": "先观察牛朝出口移动，再转向前进拦截。",
      "tips": [
        {
          "trigger": "start",
          "text": "金色格子是出口。牛看不到农夫时，会朝出口走。"
        },
        {
          "trigger": "step",
          "text": "牛正在靠近出口。判断它的下一步，再决定农夫的方向。"
        },
        {
          "trigger": "win",
          "text": "在出口前抓住了！你已经看懂牛的路线。"
        }
      ],
