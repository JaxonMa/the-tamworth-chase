{
  "title": "进阶教程",
  "subtitle": "多头牛、围栏和循环提示",
  "intro": "三节进阶课：同时应付多头牛，把牛送进围栏，认识不会判负的循环提示。",
  "badge": "进阶",
  "accent": "sky",
  "lessons": [
    {
      "id": "advanced_01",
      "name": "两头牛",
      "brief": "两头牛按固定顺序移动；抓住任意一头即可。",
      "goal": "抓住任意一头牛。",
      "practice": "观察两头牛的路线，抓住离你更近的一头。",
      "tips": [
        {
          "trigger": "start",
          "text": "场上有两头牛，它们按从左到右的固定顺序各走一步。"
        },
        {
          "trigger": "move",
          "text": "抓任意一头都算赢。先盯住离你最近的那一头。"
        },
        {
          "trigger": "win",
          "text": "多头牛时，选择一个目标，别在两条路线之间摇摆。"
        }
      ],
      "level": {
        "id": "advanced_01",
        "name": "两头牛",
        "grid": [
          "##########",
          "#........#",
          "#.#....#.#",
          "#...TT...#",
          "##.CTT..##",
          "#........#",
          "#.#...C#.#",
          "#.HHHHHH.#",
          "#..#..#F.#",
          "##########"
        ],
        "farmer_facing": "north",
        "cow_facings": [
          "east",
          "west"
        ],
        "max_turns": 20,
        "initial_obstacles": 0,
        "prediction_steps": 5,
        "win_condition": "catch",
        "pen_cells": [],
        "cows_block_each_other": true,
        "s_threshold": 7,
        "a_threshold": 10,
        "b_threshold": 13
      }
    },
    {
      "id": "advanced_02",
      "name": "围栏",
      "brief": "把所有牛赶进金色围栏格就获胜。",
      "goal": "让牛走进围栏格。",
      "practice": "等牛自己走进金色围栏格。",
      "tips": [
        {
          "trigger": "start",
          "text": "这一关的目标不是抓住牛，而是让牛走进金色围栏格。"
        },
        {
          "trigger": "wait",
          "text": "农夫无法进入围栏区。耐心等牛沿自己的路线走进来。"
        },
        {
          "trigger": "win",
          "text": "所有牛都进栏就获胜。围栏关里，牛可以不用被抓住。"
        }
      ],
      "level": {
        "id": "advanced_02",
        "name": "围栏",
        "grid": [
          "########",
          "#......#",
          "#.####.#",
          "#.#C.#.#",
          "#.#..#.#",
          "#.####.#",
          "#F.....#",
          "########"
        ],
        "farmer_facing": "east",
        "cow_facings": [
          "east"
        ],
        "max_turns": 8,
        "initial_obstacles": 0,
        "prediction_steps": 3,
        "win_condition": "pen",
        "pen_cells": [
          [
            3,
            4
          ]
        ],
        "cows_block_each_other": false,
        "s_threshold": 1,
        "a_threshold": 3,
        "b_threshold": 5
      }
    },
    {
      "id": "advanced_03",
      "name": "循环提示",
      "brief": "牛的状态重复时会出现提示，但不会判负。",
      "goal": "观察一次循环提示。",
      "practice": "连续按空格等待，直到循环提示出现。",
      "tips": [
        {
          "trigger": "start",
          "text": "连续按空格等待。牛的位置和朝向重复时，会看到循环提示。"
        },
        {
          "trigger": "wait",
          "text": "继续等。循环提示只是一条提醒，不是失败。"
        },
        {
          "trigger": "loop",
          "text": "看，牛进入了循环。你可以继续行动，或者回到布置阶段换一条路。"
        }
      ],
      "level": {
        "id": "advanced_03",
        "name": "循环提示",
        "grid": [
          "#######",
          "#.....#",
          "#.###.#",
          "#.#C#.#",
          "#.###.#",
          "#F....#",
          "#######"
        ],
        "farmer_facing": "east",
        "cow_facings": [
          "east"
        ],
        "max_turns": 20,
        "initial_obstacles": 0,
        "prediction_steps": 0,
        "win_condition": "catch",
        "pen_cells": [],
        "cows_block_each_other": false,
        "s_threshold": 4,
        "a_threshold": 8,
        "b_threshold": 12,
        "complete_on_loop": true
      }
    }
  ]
}
