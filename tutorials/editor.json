  "lessons": [
    {
      "id": "editor_01",
      "name": "画一面栅栏",
      "brief": "选择栅栏工具，在草地上画出三格。",
      "goal": "画出至少三格栅栏。",
      "practice": "选择「栅栏」，在草地上点击三次。",
      "tips": [
        {
          "trigger": "start",
          "text": "在右侧选择「栅栏」，然后在草地上点击三格。右键可以擦除。"
        },
        {
          "trigger": "place",
          "text": "继续点击。画好的栅栏会立刻出现在棋盘上。"
        }
      ],
